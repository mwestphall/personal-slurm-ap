#!/bin/bash
#
# Rendered by Open OnDemand from ood/personal_condor_system/template/script.sh.erb. Sets
# shell variables from the form, then sources the plain-shell entrypoint.sh next to
# it (staged alongside it at job runtime) which does the actual work.

set -euo pipefail

AP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BASE_DIR="<%= context.base_dir %>"
# This app always picks up the existing job queue; entrypoint.sh installs a
# fresh AP only if there isn't one yet. Creating a new queue is the AP-only app's job.
REUSE_AP="1"
CREATE_SAMPLE="<%= context.create_sample %>"
LAUNCH_EP="1"
# The EP's share of the job; the job itself also has 1 CPU and 2 GB for the AP.
EP_CPUS="<%= context.cpus.to_i %>"
EP_MEM_GB="<%= context.memory.to_i %>"

# shellcheck disable=SC1091
source "$AP_DIR/entrypoint.sh"
