#!/bin/bash
#SBATCH --job-name=htc-annex
#SBATCH --partition=<part>       # Partition to which you have job access
#SBATCH --time=4:00:00           # wall time, HH:MM:SS. Adjust based on your jobs' expected runtime.
#SBATCH --cpus-per-task=2        # CPUs for EP. Adjust based on your jobs' resource requirements.
#SBATCH --mem=4G                 # 
#SBATCH --output=annex-ep.debug
#SBATCH --error=annex-ep.debug

# sbatch copies this script into Slurm's spool dir before running it, so
# SLURM_SUBMIT_DIR (the directory sbatch was invoked from) is used to find
# sibling repo files, falling back to BASH_SOURCE for direct invocation.
SCRIPT_DIR="${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

BASE_DIR="${1:?Usage: sbatch annex-ep.sub <base-dir>}"   # base dir to create this EP's working dir in

# Resolve the well-known symlink now so this EP stays tied to this AP install
# even if current-ap is later repointed by a fresh install.
AP_DIR="$(readlink -f "$HOME/personal-htcondor/current-ap")"       # the AP's condor install dir (contains local/, condor.sh, etc.)
SOURCE="$AP_DIR/annex-default-annex.tar"                 # EP tarball written by the AP's start.sh

if [ ! -d "$AP_DIR" ]; then
  echo "ERROR: No AP found at ~/personal-htcondor/current-ap; submit ap/ap.sub first"
  exit 1
fi

if [ ! -f "$SOURCE" ]; then
  echo "ERROR: Annex tarball $SOURCE does not exist; check the AP's log for annex creation errors"
  exit 1
fi

# Unpacking multiple EPs into the same directory conflicts, so give each EP
# job its own working directory.
# EP_ID defaults to the Slurm job ID, which keeps each EP's directory and names
# unique. A preset EP_ID means we were launched as an srun step of a larger job
# (see ood/personal_condor_system).
IN_STEP="${EP_ID:+1}"
EP_ID="${EP_ID:-${SLURM_JOB_ID:?SLURM_JOB_ID is not set; run this script via sbatch}}"
EP_DIR="$BASE_DIR/ep-${EP_ID}"
echo "Creating EP working directory $EP_DIR"
mkdir -p "$EP_DIR" && cd "$EP_DIR" || {
  echo "ERROR: Failed to create or enter $EP_DIR"
  exit 1
}

echo "Unpacking $SOURCE"
tar -xvf "$SOURCE" --strip-components=1

echo ""
echo "Displaying working directory"
ls -alh

echo ""
echo "Executing annex setup script"
bash annex-setup.sh

# The annex token is minted once by the AP's start.sh, since it doesn't depend
# on the EP; see start.sh. It replaces the scope-clipped annex.token bundled in
# the tarball.
TOKEN_FILE="$AP_DIR/annex-ep.token"
if [ ! -s "$TOKEN_FILE" ]; then
  echo "ERROR: Annex token $TOKEN_FILE does not exist; check the AP's log for token minting errors"
  exit 1
fi
cp "$TOKEN_FILE" annex.token && chmod 600 annex.token || {
  echo "ERROR: Failed to install $TOKEN_FILE as annex.token"
  exit 1
}

echo ""
echo "Configuring dynamic collector and schedd-name lookup"
# AP_SCHEDD_ADDRESS_FILE just passes this path to the cron job below; see
# notes.md's "AP Address Polling" and update-annex-collector.sh.
cat >> 20-annex-pilot-instance <<EOF

AP_SCHEDD_ADDRESS_FILE = ${AP_DIR}/local/spool/.schedd_address

# Make this EP's names unique by appending its EP ID, so EPs sharing a
# worker node don't collide in the AP's collector. UID_DOMAIN and the default
# daemon names otherwise derive from the node's FULL_HOSTNAME alone.
UID_DOMAIN = \$(FULL_HOSTNAME)-${EP_ID}
STARTD_NAME = \$(FULL_HOSTNAME)-${EP_ID}
MASTER_NAME = \$(FULL_HOSTNAME)-${EP_ID}

STARTD_CRON_JOBLIST = \$(STARTD_CRON_JOBLIST) UPDATE_ANNEX_COLLECTOR
STARTD_CRON_UPDATE_ANNEX_COLLECTOR_EXECUTABLE = ${SCRIPT_DIR}/update-annex-collector.sh
STARTD_CRON_UPDATE_ANNEX_COLLECTOR_ARGS = \$(AP_SCHEDD_ADDRESS_FILE)
STARTD_CRON_UPDATE_ANNEX_COLLECTOR_MODE = Periodic
STARTD_CRON_UPDATE_ANNEX_COLLECTOR_PERIOD = 60
STARTD_CRON_LOG_NON_ZERO_EXIT = True
EOF

echo ""
echo "Executing HTC annex slurm script"
# annex-setup.sh wraps its node script in `srun` whenever SLURM_JOBID is set,
# which fails when nested inside our own srun step (CPU binding outside of the
# step's allocation). Unset it (SLURM_JOB_ID stays set) so it runs directly.
if [ -n "$IN_STEP" ]; then
  unset SLURM_JOBID
fi
export SLURM_EXPORT_ENV=ALL
bash hpc.slurm > annex-job.out 2> annex-job.err
status=$?
echo "hpc.slurm exited with status ${status}"
exit "${status}"
