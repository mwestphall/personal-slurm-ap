<%
  # Only one AP can listen on port 9618 per node, and the firewall rules out
  # other ports, so keep this AP off any node already running a personal AP
  # (from any user). See notes.md's "Port Collisions".
  ap_job_names = %w[sys/dashboard/sys/personal_ap sys/dashboard/dev/personal_ap]
  busy_nodes = begin
    out = IO.popen(["squeue", "-h", "-t", "R,CF", "-n", ap_job_names.join(","), "-o", "%N"],
                   err: File::NULL, &:read)
    out.split("\n").map(&:strip).reject(&:empty?).uniq.join(",")
  rescue StandardError
    ""
  end

  # The AP needs fewer resources than an EP. With small per-node allocations it
  # gets its own node; otherwise it shares the first node with an EP. Keep in
  # sync with template/script.sh.erb.
  ap_shares_node = cpus.to_i > 2 && memory.to_i > 4
  num_nodes = ap_shares_node ? num_eps.to_i : num_eps.to_i + 1
%>
---
batch_connect:
  template: basic
script:
  native:
    - "-p"
    - "<%= slurm_partition %>"
    - "-N"
    - "<%= num_nodes %>"
    - "-c"
    - "<%= cpus %>"
    - "--mem"
    - "<%= memory %>G"
    - "-t"
    - "<%= time_limit %>"
<% unless busy_nodes.empty? %>
    - "--exclude"
    - "<%= busy_nodes %>"
<% end %>
