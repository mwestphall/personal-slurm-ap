<%
  # Offer to reuse the existing AP only if there is one to reuse.
  existing_ap = File.symlink?(File.join(Dir.home, "personal-htcondor", "current-ap"))
%>
---
cluster: "*" # Glob: show a dropdown of every cluster configured on this OOD instance.
form:
  - slurm_partition
  - time_limit
<% if existing_ap %>
  - reuse_ap
<% end %>
  - create_sample
  - submit_sample
  - submit_files
  - exit_after_submit
  - base_dir

attributes:
  slurm_partition:
    widget: text_field
    label: "Slurm partition"
    value: "shared"
    required: true
  time_limit:
    widget: text_field
    label: "Time limit"
    value: "4:00:00"
    help: "Slurm time format, e.g. HH:MM:SS or D-HH:MM:SS. The AP runs only as long as this job does."
<% if existing_ap %>
  reuse_ap:
    widget: check_box
    label: "Recover Job Queue"
    value: "1"
    checked_value: "1"
    unchecked_value: "0"
    help: >-
      Keep the job queue from your previous personal HTCondor session. Uncheck to discard it and
      create a new, empty job queue.
<% end %>
  create_sample:
    widget: check_box
    label: "Create Sample Submit File"
    value: "1"
    checked_value: "1"
    unchecked_value: "0"
    help: >-
      Create an example HTCondor submit file and its executable in
      `~/personal-htcondor/sample-submit/`
  submit_sample:
    widget: check_box
    label: "Submit Sample Job"
    value: "0"
    checked_value: "1"
    unchecked_value: "0"
    help: >-
      Automatically submit the sample job to your queue once the AP is running. This also creates
      the sample submit file, whether or not "Create Sample Submit File" is checked.
  submit_files:
    widget: text_area
    label: "Submit Files"
    value: ""
    rows: 4
    help: >-
      Submit files to submit once the AP is running, one path per line (`~` is allowed). Each file is submitted
      from its own directory; files ending in `.dag` are submitted with `condor_submit_dag`.
  exit_after_submit:
    widget: check_box
    label: "Exit After Submitting"
    value: "0"
    checked_value: "1"
    unchecked_value: "0"
    help: >-
      Stop this session as soon as all of the jobs above have been submitted successfully. Your queue is kept, and its
      jobs run the next time you launch a cluster. Has no effect if nothing is selected for submission.
  base_dir:
    widget: text_field
    label: "Base install directory"
    value: ""
    help: >-
      Working directory for your HTCondor cluster. Must be on shared storage, 
      accessible from both the login node and all worker nodes. Defaults to /scratch/$USER.
