<%
  # Offer to reuse the existing AP only if there is one to reuse.
  existing_ap = File.symlink?(File.join(Dir.home, "personal-htcondor", "current-ap"))
%>
---
cluster: "*" # Glob: show a dropdown of every cluster configured on this OOD instance.
form:
  - slurm_partition
  - time_limit
<% if existing_ap %>
  - reuse_ap
<% end %>
  - create_sample
  - base_dir

attributes:
  slurm_partition:
    widget: text_field
    label: "Slurm partition"
    value: "shared"
    required: true
  time_limit:
    widget: text_field
    label: "Time limit"
    value: "4:00:00"
    help: "Slurm time format, e.g. HH:MM:SS or D-HH:MM:SS. The AP runs only as long as this job does."
<% if existing_ap %>
  reuse_ap:
    widget: check_box
    label: "Recover Job Queue"
    value: "1"
    checked_value: "1"
    unchecked_value: "0"
    help: >-
      Keep the job queue from your previous personal HTCondor session. Uncheck to discard it and
      create a new, empty job queue.
<% end %>
  create_sample:
    widget: check_box
    label: "Create Sample Submit File"
    value: "1"
    checked_value: "1"
    unchecked_value: "0"
    help: >-
      Create an example HTCondor submit file and its executable in
      `~/personal-htcondor/sample-submit/`
  base_dir:
    widget: text_field
    label: "Base install directory"
    value: ""
    help: >-
      Working directory for your HTCondor cluster. Must be on shared storage, 
      accessible from both the login node and all worker nodes. Defaults to /scratch/$USER.
