<%
  # Offer to reuse the existing AP only if there is one to reuse.
  existing_ap = File.symlink?(File.join(Dir.home, "personal-htcondor", "current-ap"))

  # Partitions that are up and that the user may submit to. sacctmgr lists the
  # partitions the user's associations are limited to; an association with an
  # empty partition field is unrestricted. Falls back to a plain text field
  # (see below) if Slurm can't be queried. Keep in sync with the other form.
  require "json"
  partitions = begin
    up = IO.popen(["sinfo", "-h", "-o", "%R|%a"], err: File::NULL, &:read).split("\n")
           .map { |l| l.strip.split("|") }.select { |_, state| state == "up" }.map(&:first)
    assocs = IO.popen(["sacctmgr", "-nP", "show", "assoc", "user=#{ENV['USER'] || Etc.getpwuid.name}", "format=partition"],
                      err: File::NULL, &:read).split("\n", -1).map(&:strip)[0..-2] || []
    allowed = assocs.empty? || assocs.include?("") ? up : up & assocs.flat_map { |a| a.split(",") }
    allowed.uniq.sort
  rescue StandardError
    []
  end
  default_partition = partitions.include?("shared") ? "shared" : partitions.first
%>
---
cluster: "*" # Glob: show a dropdown of every cluster configured on this OOD instance.
form:
  - slurm_partition
  - num_eps
  - cpus
  - memory
  - time_limit
<% if existing_ap %>
  - reuse_ap
<% end %>
  - create_sample
  - base_dir

attributes:
<% if partitions.empty? %>
  slurm_partition:
    widget: text_field
    label: "Slurm partition"
    value: "shared"
    required: true
<% else %>
  slurm_partition:
    widget: select
    label: "Slurm partition"
    value: "<%= default_partition %>"
    options: <%= partitions.to_json %>
    required: true
<% end %>
  num_eps:
    widget: number_field
    label: "Number of Execution Points"
    value: 1
    min: 1
    max: 10
    help: >-
      EPs provide compute capacity to your HTCondor cluster. You can add additional EPs later with
      the "Extend Personal HTCondor" app.
  cpus:
    widget: number_field
    label: "CPUs per node"
    value: 1
    min: 1
    max: 4
    help: >-
      CPUs to allocate to each EP in the cluster. Limited to 4 in your base cluster. You can add
      larger EPs later with the "Extend Personal HTCondor" app.
  memory:
    widget: number_field
    label: "Memory per node (GB)"
    value: 2
    min: 1
    max: 16
    help: >-
      Memory (GBs) to allocate to each EP in the cluster. Limited to 16 GB in your base cluster. You can add
      larger EPs later with the "Extend Personal HTCondor" app.
  time_limit:
    widget: text_field
    label: "Time limit"
    value: "4:00:00"
    help: "Slurm time format, e.g. HH:MM:SS or D-HH:MM:SS. The AP runs only as long as this job does."
<% if existing_ap %>
  reuse_ap:
    widget: check_box
    label: "Recover Job Queue"
    value: "1"
    checked_value: "1"
    unchecked_value: "0"
    help: >-
      Recover the job queue from your previous personal HTCondor cluster. If unchecked,
      a new, empty job queue will be created.
<% end %>
  create_sample:
    widget: check_box
    label: "Create Sample Submit File"
    value: "1"
    checked_value: "1"
    unchecked_value: "0"
    help: >-
      Create an example HTCondor submit file and its executable in
      `~/personal-htcondor/sample-submit/`
  base_dir:
    widget: text_field
    label: "Base install directory"
    value: ""
    help: >-
      Working directory for your HTCondor cluster. Must be on shared storage, 
      accessible from both the login node and all worker nodes. Defaults to /scratch/$USER.
