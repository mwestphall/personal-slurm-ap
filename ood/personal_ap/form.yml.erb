<%
  # Offer to reuse the existing AP only if there is one to reuse.
  existing_ap = File.symlink?(File.join(Dir.home, ".cache", "current-ap"))
%>
---
cluster: "*" # Glob: show a dropdown of every cluster configured on this OOD instance.
form:
  - slurm_partition
  - num_nodes
  - cpus
  - memory
  - time_limit
<% if existing_ap %>
  - reuse_ap
<% end %>
  - base_dir

attributes:
  slurm_partition:
    widget: text_field
    label: "Slurm partition"
    value: "shared"
    required: true
  num_nodes:
    widget: number_field
    label: "Number of nodes"
    value: 1
    min: 1
    help: >-
      The first node runs the AP; each additional node runs an EP that attaches to it. Leave
      at 1 to run the AP alone and launch EPs separately.
  cpus:
    widget: number_field
    label: "CPUs per node"
    value: 1
    min: 1
    help: "Applies to every node, including EP nodes, so raise it when requesting more than one node."
  memory:
    widget: number_field
    label: "Memory per node (GB)"
    value: 2
    min: 1
  time_limit:
    widget: text_field
    label: "Time limit"
    value: "4:00:00"
    help: "Slurm time format, e.g. HH:MM:SS or D-HH:MM:SS. The AP runs only as long as this job does."
<% if existing_ap %>
  reuse_ap:
    widget: check_box
    label: "Reuse existing AP"
    value: "1"
    checked_value: "1"
    unchecked_value: "0"
    help: >-
      Resume the AP at ~/.cache/current-ap. Uncheck to install a fresh AP instead, which
      replaces it.
<% end %>
  base_dir:
    widget: text_field
    label: "Base install directory"
    value: ""
    help: >-
      Where to install a fresh AP (HTCondor is downloaded automatically), and where any EPs
      launched with the AP (see "Number of nodes") create their working directories, on storage
      shared with the login node. Defaults to /scratch/$USER if left blank. Not used for the AP when
      resuming an existing AP.
