#!/bin/bash
#SBATCH --job-name=htc-annex
#SBATCH --partition=<part>       # Partition to which you have job access
#SBATCH --time=4:00:00           # wall time, HH:MM:SS. Adjust based on your jobs' expected runtime.
#SBATCH --cpus-per-task=2        # CPUs for EP. Adjust based on your jobs' resource requirements.
#SBATCH --mem=4G                 # 
#SBATCH --output=annex-ep.debug
#SBATCH --error=annex-ep.debug

# sbatch copies this script into Slurm's spool dir before running it, so
# SLURM_SUBMIT_DIR (the directory sbatch was invoked from) is used to find
# sibling repo files, falling back to BASH_SOURCE for direct invocation.
SCRIPT_DIR="${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

# Resolve the well-known symlink now so this EP stays tied to this AP install
# even if current-ap is later repointed by a fresh install.
AP_DIR="$(readlink -f "$HOME/personal-htcondor/current-ap")"       # the AP's condor install dir (contains local/, condor.sh, etc.)
SOURCE="$AP_DIR/annex-default-annex.tar"                 # EP tarball written by the AP's start.sh

if [ ! -d "$AP_DIR" ]; then
  echo "ERROR: No AP found at ~/personal-htcondor/current-ap; submit ap/ap.sub first"
  exit 1
fi

if [ ! -f "$SOURCE" ]; then
  echo "ERROR: Annex tarball $SOURCE does not exist; check the AP's log for annex creation errors"
  exit 1
fi

# Multiple EPs may run from the same working dir, so everything this script
# writes there is named by a per-EP ID.
# EP_ID defaults to the Slurm job ID; a multi-node job launching several EPs
# (see ood/personal_ap) sets it per node so they don't share names.
EP_ID="${EP_ID:-${SLURM_JOB_ID:?SLURM_JOB_ID is not set; run this script via sbatch}}"
# Condor's and hpc.slurm's logs go in a per-EP dir in the job's working dir, so
# they're visible outside the container. The EP itself is unpacked and run
# inside the container.
LOG_DIR="$PWD/ep-${EP_ID}/logs"
echo "Creating EP log directory $LOG_DIR"
# Likewise for the EP's execute dir, so job sandboxes get the job's real
# working-dir disk rather than the container's /tmp.
EXECUTE_DIR="$PWD/ep-${EP_ID}/execute"
echo "Creating EP execute directory $EXECUTE_DIR"
mkdir -p "$LOG_DIR" "$EXECUTE_DIR" || {
  echo "ERROR: Failed to create $LOG_DIR or $EXECUTE_DIR"
  exit 1
}

# The annex token is minted once by the AP's start.sh, since it doesn't depend
# on the EP; see start.sh.
TOKEN_FILE="$AP_DIR/annex-ep.token"
if [ ! -s "$TOKEN_FILE" ]; then
  echo "ERROR: Annex token $TOKEN_FILE does not exist; check the AP's log for token minting errors"
  exit 1
fi

echo ""
echo "Starting annex EP inside Apptainer"
# Everything past token minting runs in the container; see annex-ep-init.sh.
# Inputs are mounted read-only under /annex-in, the log dir at /ep-logs
# (condor's LOG, plus annex-job.out/err), and the execute dir at /ep-execute.
# The container has no access to update-annex-collector.sh's shared-FS
# locations, so that cron job is expected to fail for now.
apptainer exec \
  --bind "$SOURCE:/annex-in/annex.tar:ro" \
  --bind "$TOKEN_FILE:/annex-in/annex.token:ro" \
  --bind "$SCRIPT_DIR/update-annex-collector.sh:/annex-in/update-annex-collector.sh:ro" \
  --bind "$SCRIPT_DIR/annex-ep-init.sh:/annex-in/annex-ep-init.sh:ro" \
  --bind "$LOG_DIR:/ep-logs" \
  --bind "$EXECUTE_DIR:/ep-execute" \
  --env "AP_DIR=$AP_DIR" \
  --env "EP_ID=$EP_ID" \
  docker://almalinux:9 bash /annex-in/annex-ep-init.sh
status=$?
echo "annex EP container exited with status ${status}"
exit "${status}"
