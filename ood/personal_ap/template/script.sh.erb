#!/bin/bash
#
# Rendered by Open OnDemand from ood/personal_ap/template/script.sh.erb. Thin
# wrapper around install.sh and start.sh, copied alongside this script into
# ood/personal_ap/template/ (and staged alongside it at job runtime) so this
# app is self-contained; see ood-plan.md and the repo README's "Launch an AP
# via Open OnDemand" section.

set -euo pipefail

AP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BASE_DIR="<%= context.base_dir %>"
BASE_DIR="${BASE_DIR:-/scratch/$USER}" # only used for a fresh install
CURRENT_AP="$HOME/personal-htcondor/current-ap"

# reuse_ap is only on the form (checked by default) when there is an existing AP.
REUSE_AP="<%= context.respond_to?(:reuse_ap) ? context.reuse_ap : "0" %>"

if [ "$REUSE_AP" = "1" ] && [ -d "$CURRENT_AP" ]; then
    echo "==> Resuming existing AP at $CURRENT_AP"
else
    echo "==> Installing a fresh AP"
    if ! INSTALL_OUTPUT="$("$AP_DIR/install.sh" --base-dir "$BASE_DIR")"; then
        echo "$INSTALL_OUTPUT"
        echo "error: install.sh failed" >&2
        exit 1
    fi
    echo "$INSTALL_OUTPUT"
fi

CONDOR_DIR="$(readlink -f "$CURRENT_AP")"

# Copy the sample job (template/sample-job) into ~/personal-htcondor/sample-submit,
# leaving any files the user already has there alone. Never fatal: a failure
# here only logs a warning.
create_sample_submit() {
    local dir="$HOME/personal-htcondor/sample-submit" file
    mkdir -p "$dir" || return 1

    for file in "$AP_DIR"/sample-job/*; do
        [ -e "$dir/$(basename "$file")" ] || cp -p "$file" "$dir/" || return 1
    done

    echo "==> Sample job copied to $dir (see README.md there)"
}

if [ "<%= context.create_sample %>" = "1" ]; then
    create_sample_submit || echo "WARNING: could not create the sample submit file; continuing" >&2
fi

# This node (the first allocated) runs the AP; every other node runs an EP
# (the job has num_eps + 1 nodes). Wait for the AP to finish building the annex
# tarball, then start one EP per remaining node as job steps (Slurm cleans them
# up with the job).
NUM_EPS="<%= context.num_eps.to_i %>"

launch_eps() {
    local ready="$CONDOR_DIR/annex-ready" waited=0
    while [ ! -f "$ready" ]; do
        if [ "$waited" -ge 300 ]; then
            echo "error: AP annex not ready after 300s; not launching EPs" >&2
            return 1
        fi
        sleep 2
        waited=$((waited + 2))
    done

    local ep_nodes
    ep_nodes="$(scontrol show hostnames "$SLURM_JOB_NODELIST" | tail -n +2 | paste -sd,)"
    echo "==> Launching EPs on: $ep_nodes"

    # annex-ep.sub locates update-annex-collector.sh via SLURM_SUBMIT_DIR, and
    # reads EP_ID so each node gets its own working dir and daemon names.
    export SLURM_SUBMIT_DIR="$AP_DIR"
    # OOD submits with a restricted environment that srun steps inherit, leaving
    # the step without PATH ("execve(): bash: No such file or directory"), so
    # pass this script's environment through and give srun bash's absolute path.
    # --cpus-per-task is explicit because srun doesn't reliably inherit it from
    # the job ("More processors requested than permitted" otherwise).
    srun --label --export=ALL --nodes=$NUM_EPS --ntasks=$NUM_EPS --ntasks-per-node=1 \
        --cpus-per-task="${SLURM_CPUS_PER_TASK:-1}" \
        --nodelist="$ep_nodes" \
        "$(command -v bash)" -c 'EP_ID="${SLURM_JOB_ID}-${SLURM_NODEID}" exec bash "$0/annex-ep.sub" "$1"' \
        "$AP_DIR" "$BASE_DIR"
}

launch_eps &

# Periodically write the file that view.html.erb reads, into the AP's shared
# dir. Runs in the background alongside the AP, and is cleaned up with the job.
"$AP_DIR/update-view.sh" --condor-dir "$CONDOR_DIR" &

exec "$AP_DIR/start.sh" --condor-dir "$CONDOR_DIR"
