# Executable file to run in this HTCondor job
executable              = plot.R
container_image         = docker://r-base

# Output files for this HTCondor job
log                     = log/plot.log
output                  = log/plot.out
error                   = log/plot.err

# Instruct HTCondor to transfer the executable and other input files to worker nodes
should_transfer_files   = Yes 
when_to_transfer_output = ON_EXIT
transfer_input_files    = squared/
transfer_output_files   = plot.png

# Resource requests for the job. The job will only run on worker nodes with sufficient resources.
request_cpus            = 1
request_memory          = 1G
request_disk            = 1G

queue
