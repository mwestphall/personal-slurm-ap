# Executable file to run in the plotting HTCondor Job (a short, custom R script)
executable              = plot.R

# Define a container for this job: Create a fixed environment with dependencies pre-installed,
# Regardless of what's installed directly on the Execution Point
container_image         = docker://r-base

# Output files for this HTCondor job
log                     = log/plot.log
output                  = log/plot.out
error                   = log/plot.err

should_transfer_files   = Yes 
when_to_transfer_output = ON_EXIT

# Transfer the outputs of the previous stage into the input of this job
transfer_input_files    = squared/
# Transfer the plot produced by this job back to the working directory
transfer_output_files   = plot.png

# Resource requests for the job. The job will only run on worker nodes with sufficient resources.
request_cpus            = 1
request_memory          = 1G
request_disk            = 1G

queue
